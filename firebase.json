{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "site": "smartcontentcreator2",
    "public": "web_landing",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/Stote/**",
      "*.apk",
      "**/*.apk"
    ],
    "rewrites": [
      {
        "source": "/app/**",
        "function": "server"
      },
      {
        "source": "/api/**",
        "function": "server"
      }
    ],
    "headers": [
      {
        "source": "/app/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "codebase": "default",
      "source": "functions",
      "runtime": "nodejs22"
    },
    {
      "source": "backend",
      "codebase": "functions",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
