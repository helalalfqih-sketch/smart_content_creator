rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ✅ يسمح للجميع بتحميل ملف التطبيق الرسمي
    match /public/app-latest.apk {
      allow read: if true;
      allow write: if false; // الحماية من التعديل الخارجي
    }

    // 💬 وسائط دردشة الذكاء الاصطناعي
    match /chat_media/{chatId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // 🛍️ وسائط كتالوج المنتجات
    match /users/{userId}/catalog_media/{allPaths=**} {
      allow read: if true; // ✅ يجب أن تكون الصور عامة لتظهر في كتالوج فيسبوك
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 📑 تغذية الكتالوج لـ Meta (CSV)
    match /catalogs/{userId}/{allPaths=**} {
      allow read: if true; // ✅ يجب أن يكون الملف عاماً ليتمكن سيرفر فيسبوك من جلب البيانات
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // المجلدات الأخرى كاحتياط
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
