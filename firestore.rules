rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ✅ Helper: Check if the current user is an Admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // ✅ Users Collection & Sub-collections
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // Match sub-collections (chats, etc.)
      match /{allPaths=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    // 💎 SaaS Subscriptions
    match /subscriptions/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // ⚙️ App Settings & Global Config
    match /app_settings/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /global_config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ui_controls/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /user_permissions/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /user_activity_logs/{id} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // 🛍️ Shared Global Product Catalog
    match /catalog_products/{productId} {
      allow read: if true; // Everyone can view products
      allow create: if request.auth != null; // Registered users can upload products
      allow update, delete: if request.auth != null && 
        (resource.data.creatorUid == request.auth.uid || isAdmin());
    }
  }
}
